[0.075, "o", "\u001b[0;32mIngress Controller NodePort: 30390\u001b[0m\r\n\u001b[0;34mSetting up port-forward for Ingress...\u001b[0m\r\n"]
[0.089, "o", "Forwarding from 127.0.0.1:8081 -> 80\r\n"]
