[0.000, "o", "\u001b[0;32m✓ Application is accessible on http://localhost:8080\u001b[0m\r\n\r\n\u001b[0;34mStep 7: Alternative access method - Direct node access...\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;33mMethod 2: Accessing via Docker exec to the node\u001b[0m\r\n\u001b[1;33mThis demonstrates direct access to the kind node...\u001b[0m\r\n"]
[0.087, "o", "\u001b[0;32mNode IP: 172.18.0.2\u001b[0m\r\n\u001b[1;33mYou can access via: curl http://172.18.0.2:30759\u001b[0m\r\n\u001b[1;33mOr use Docker port mapping: docker port demo-cluster-control-plane\u001b[0m\r\n"]
