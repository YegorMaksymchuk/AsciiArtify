[0.644, "o", "=== k3d Demo: Hello World Deployment ===\r\n\r\n"]
[0.001, "o", "\u001b[0;34mStep 1: Creating k3d cluster with port forwarding...\u001b[0m\r\n"]
[0.027, "o", "\u001b[36mINFO\u001b[0m[0000] portmapping '8080:80' targets the loadbalancer: defaulting to [servers:*:proxy agents:*:proxy] \r\n"]
[0.000, "o", "\u001b[36mINFO\u001b[0m[0000] portmapping '8443:443' targets the loadbalancer: defaulting to [servers:*:proxy agents:*:proxy] \r\n"]
[0.002, "o", "\u001b[36mINFO\u001b[0m[0000] Prep: Network                                \r\n"]
[0.022, "o", "\u001b[36mINFO\u001b[0m[0000] Created network 'k3d-demo-cluster'           \r\n"]
[0.002, "o", "\u001b[36mINFO\u001b[0m[0000] Created image volume k3d-demo-cluster-images \r\n"]
[0.005, "o", "\u001b[36mINFO\u001b[0m[0000] Starting new tools node...                   \r\n"]
[0.045, "o", "\u001b[36mINFO\u001b[0m[0000] Starting node 'k3d-demo-cluster-tools'       \r\n"]
[0.957, "o", "\u001b[36mINFO\u001b[0m[0001] Creating node 'k3d-demo-cluster-server-0'    \r\n"]
[0.031, "o", "\u001b[36mINFO\u001b[0m[0001] Creating LoadBalancer 'k3d-demo-cluster-serverlb' \r\n"]
[0.028, "o", "\u001b[36mINFO\u001b[0m[0001] Using the k3d-tools node to gather environment information \r\n"]
[0.224, "o", "\u001b[36mINFO\u001b[0m[0001] HostIP: using network gateway 172.19.0.1 address \r\n\u001b[36mINFO\u001b[0m[0001] Starting cluster 'demo-cluster'              \r\n\u001b[36mINFO\u001b[0m[0001] Starting servers...                          \r\n"]
[0.031, "o", "\u001b[36mINFO\u001b[0m[0001] Starting node 'k3d-demo-cluster-server-0'    \r\n"]
[3.818, "o", "\u001b[36mINFO\u001b[0m[0005] All agents already running.                  \r\n\u001b[36mINFO\u001b[0m[0005] Starting helpers...                          \r\n"]
[0.021, "o", "\u001b[36mINFO\u001b[0m[0005] Starting node 'k3d-demo-cluster-serverlb'    \r\n"]
[6.391, "o", "\u001b[36mINFO\u001b[0m[0011] Injecting records for hostAliases (incl. host.k3d.internal) and for 2 network members into CoreDNS configmap... \r\n"]
[2.030, "o", "\u001b[36mINFO\u001b[0m[0013] Cluster 'demo-cluster' created successfully! \r\n"]
[0.020, "o", "\u001b[36mINFO\u001b[0m[0013] You can now use it like this:                \r\nkubectl cluster-info\r\n"]
[0.001, "o", "\u001b[0;32m✓ Cluster created successfully\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[0;34mStep 2: Verifying cluster status...\u001b[0m\r\n"]
[0.304, "o", "Kubernetes control plane is running at https://0.0.0.0:53531\r\nCoreDNS is running at https://0.0.0.0:53531/api/v1/namespaces/kube-system/services/kube-dns:dns/proxy\r\nMetrics-server is running at https://0.0.0.0:53531/api/v1/namespaces/kube-system/services/https:metrics-server:https/proxy\r\n\r\nTo further debug and diagnose cluster problems, use 'kubectl cluster-info dump'.\r\n"]
[0.064, "o", "NAME                        STATUS   ROLES                  AGE   VERSION\r\nk3d-demo-cluster-server-0   Ready    control-plane,master   9s"]
[0.000, "o", "    v1.31.5+k3s1\r\n"]
[0.001, "o", "\r\n\u001b[0;34mStep 3: Deploying Hello World application...\u001b[0m\r\n"]
[0.068, "o", "deployment.apps/hello-world created\r\n"]
[34.165, "o", "deployment.apps/hello-world condition met\r\n"]
[0.002, "o", "\u001b[0;32m✓ Deployment created\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[0;34mStep 4: Exposing service as LoadBalancer...\u001b[0m\r\n"]
[0.337, "o", "service/hello-world-service exposed\r\n"]
[0.002, "o", "\u001b[0;32m✓ Service exposed\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[0;34mStep 5: Waiting for service to be ready...\u001b[0m\r\n"]
[5.076, "o", "NAME                           READY   STATUS    RESTARTS   AGE\r\nhello-world-7b4644cd6f-nmbnd   1/1     Running   0          39s\r\n"]
[0.069, "o", "NAME                  TYPE           CLUSTER-IP     EXTERNAL-IP   PORT(S)        AGE\r\nhello-world-service   LoadBalancer   10.43.246.40   <pending>     80:30951/TCP   5s\r\nkubernetes            ClusterIP"]
[0.000, "o", "      10.43.0.1      <none>        443/TCP        49s\r\n"]
[0.001, "o", "\r\n\u001b[0;34mStep 6: Testing access to application...\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;33mAccessing http://localhost:8080\u001b[0m\r\n"]
[0.016, "o", "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n<title>Welcome to nginx!</title>\r\n<style>\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "\u001b[0;32m✓ Application is accessible on http://localhost:8080\u001b[0m\r\n\r\n\u001b[0;34mStep 7: Creating Ingress example...\u001b[0m\r\n"]
[0.092, "o", "ingress.networking.k8s.io/hello-world-ingress created\r\n"]
[0.001, "o", "\u001b[0;32m✓ Ingress created\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[0;32m=== Demo Complete ===\u001b[0m\r\n\r\nSummary:\r\n  - Cluster created in seconds\r\n"]
[0.000, "o", "  - Application deployed and accessible\r\n"]
[0.000, "o", "  - Port forwarding works automatically\r\n  - LoadBalancer and Ingress ready to use\r\n"]
[0.000, "o", "\r\nAccess points:\r\n"]
[0.000, "o", "  - http://localhost:8080 (LoadBalancer)\r\n  - http://hello.local (Ingress - add to /etc/hosts)\r\n\r\n"]
[0.000, "o", "To clean up, run:\r\n  k3d cluster delete demo-cluster\r\n"]
[0.000, "x", "0"]
